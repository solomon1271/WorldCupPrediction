generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  displayName           String
  passwordHash          String
  isAdmin               Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  leagueMembers         LeagueMember[]
  matchPredictions      MatchPrediction[]
  tournamentPredictions TournamentPrediction[]
  matchWinnerRevealSeen MatchWinnerRevealSeen[]
  groupStageRevealSeen  GroupStageRevealSeen[]
}

model League {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  name                     String
  inviteCode               String                    @unique
  subtitle                 String                    @default("2026 World Cup Challenge")
  isPaused                 Boolean                   @default(false)
  isHidden                 Boolean                   @default(false)
  officialAwardsJson       String                    @default("{}")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  members                  LeagueMember[]
  matchPredictions         MatchPrediction[]
  tournamentPredictions    TournamentPrediction[]
  leaderboardState         LeaderboardState?
  knockoutLeaderboardState KnockoutLeaderboardState?
  matchWinnerRevealSeen    MatchWinnerRevealSeen[]
  groupStageRevealSeen     GroupStageRevealSeen[]
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  joinedAt DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}

model Match {
  id                    Int                     @id
  stage                 String
  kickoff               DateTime
  venue                 String
  homeTeam              String
  awayTeam              String
  isLocked              Boolean                 @default(false)
  predictionUnlockUntil DateTime?
  finalHomeScore        Int?
  finalAwayScore        Int?
  finalYellowCards      Int?
  finalTotalCorners     Int?
  finalRedCards         Int?
  finalResultAt         DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  predictions           MatchPrediction[]
  matchWinnerRevealSeen MatchWinnerRevealSeen[]
}

model MatchPrediction {
  id               String   @id @default(cuid())
  leagueId         String
  userId           String
  matchId          Int
  winner           String
  homeScore        Int?
  awayScore        Int?
  totalGoalsLine   String
  totalCornersLine String   @default("0")
  yellowCardsLine  String
  redCardsLine     String   @default("0")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  league           League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId, matchId])
}

model LeaderboardState {
  leagueId          String   @id
  ranksJson         String   @default("{}")
  previousRanksJson String   @default("{}")
  updatedAt         DateTime @updatedAt
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model KnockoutLeaderboardState {
  leagueId          String   @id
  ranksJson         String   @default("{}")
  previousRanksJson String   @default("{}")
  updatedAt         DateTime @updatedAt
  league            League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model TournamentPrediction {
  id              String   @id @default(cuid())
  leagueId        String
  userId          String
  champion        String?
  runnerUp        String?
  goldenBoot      String?
  bestYoungPlayer String?
  goldenGlove     String?
  bestPlayer      String?
  groupWinners    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  league          League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
}

model MatchWinnerRevealSeen {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  matchId  Int
  seenAt   DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId, matchId])
  @@index([userId])
}

model GroupStageRevealSeen {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  seenAt   DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}
