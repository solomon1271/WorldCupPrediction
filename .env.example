# Postgres (e.g. production on Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/worldcup?sslmode=require"
# Local SQLite: path is relative to the prisma/ folder (creates/opens prisma/dev.db)
# DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
INVITE_CODE="replace-with-your-private-invite-code"
# Legacy fallback when seeding the default NewRez league locally. Production leagues live in the database.
ADMIN_EMAIL="your-admin-email@example.com"
# Optional: bump to invalidate all sessions locally (prod uses VERCEL_DEPLOYMENT_ID automatically).
# SESSION_DEPLOYMENT_ID="1"
MATCH_SYNC_URL="https://example.com/world-cup-fixtures.json"
# Optional local file override for scripts/cron (takes precedence over MATCH_SYNC_URL).
# MATCH_SYNC_FILE="public/match-sync-test.json"
MATCH_LOCK_LEAD_MINUTES="5"
CRON_SECRET="replace-with-a-long-random-secret"
CRON_TIMEZONE="America/Chicago"
NEXT_PUBLIC_CRON_TIMEZONE="America/Chicago"
# Top picks lock at the start of this date in CRON_TIMEZONE (knockout begins June 28, 2026).
TOURNAMENT_PICKS_LOCK_DATE="2026-06-28"
# Optional temporary reopen window (ISO datetime). While now < this value, top picks stay editable even after lock date.
# Generate with: npm run tournament:unlock
# TOURNAMENT_PICKS_UNLOCK_UNTIL="2026-07-05T21:16:48.027Z"
