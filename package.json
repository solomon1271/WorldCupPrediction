{
  "name": "world-cup-picks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run db:generate && NEXT_DIST_DIR=.next-dev node scripts/reset-next-cache.mjs && NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate:prod": "prisma migrate dev --schema prisma/schema.postgres.prisma",
    "db:deploy:prod": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:resolve-failed-group-stage-migration:prod": "prisma migrate resolve --rolled-back 20260627_group_stage_reveal_seen --schema prisma/schema.postgres.prisma",
    "db:status:prod": "prisma migrate status --schema prisma/schema.postgres.prisma",
    "db:seed:prod": "npm run db:generate:prod && tsx prisma/seed.ts",
    "db:inspect:prod": "npm run db:generate:prod && tsx scripts/db-inspect-matches.ts",
    "matches:feed:local": "tsx scripts/generate-local-match-feed.ts",
    "matches:sync": "tsx scripts/sync-matches.ts",
    "matches:sync:test": "MATCH_SYNC_FILE=public/match-sync-test.json tsx scripts/sync-matches.ts",
    "matches:reset:test": "tsx scripts/reset-test-matches.ts",
    "matches:unlock": "tsx scripts/unlock-match-predictions.ts",
    "matches:unlock:prod": "npm run db:generate:prod && tsx scripts/unlock-match-predictions.ts -- --until-kickoff",
    "tournament:unlock": "tsx scripts/unlock-tournament-picks.ts",
    "league:status": "tsx scripts/set-league-status.ts",
    "tournament:reset": "tsx scripts/reset-for-tournament.ts",
    "matches:lock": "tsx scripts/lock-matches.ts",
    "matches:maintain": "tsx scripts/run-match-maintenance.ts",
    "matches:maintain:daily": "tsx scripts/daily-maintain.ts",
    "league:create": "tsx scripts/create-league.ts",
    "flags:download": "tsx scripts/download-team-flags.ts",
    "players:download": "tsx scripts/download-team-player-images.ts",
    "db:backfill-leagues": "tsx scripts/backfill-local-leagues.ts",
    "vercel-build": "npm run db:generate:prod && (npm run db:resolve-failed-group-stage-migration:prod || true) && PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 npm run db:deploy:prod && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "next": "^15.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "prisma": "^6.17.1",
    "sharp": "^0.34.3",
    "tsx": "^4.21.0",
    "typescript": "5.8.3"
  }
}
